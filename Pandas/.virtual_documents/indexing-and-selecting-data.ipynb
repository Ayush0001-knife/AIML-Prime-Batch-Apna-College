import pandas as pd


data = pd.read_csv("globalAirQuality.csv")
data


# Selecting Data

#Column wise 
data["country"]
data[["city","aqi"]]


# Row Wise 

# Using loc
data.loc[0]
data.loc[1:3]    # Here starting idx : ending idx   and ending idx is inclusive here

#using iloc
data.iloc[2]
data.iloc[1:3]    # Here starting idx : ending idx   and ending idx is exclusive here



# If we want to access a single cell (row,column)

#loc based
data.loc[0,"aqi"]
data.loc[0,["city","aqi"]]
data.loc[0:2,["city","aqi"]]


#iloc based 
# here we wil hev to pass the only index values 
data.iloc[0,11]       # here we have passed 11 which is the index value of cloumn aqi
data.iloc[0,[2,11]]    # here we have passed 2 and 11 which are the index values of column city as well as aqi
data.iloc[0:2,[2,11]]
data.iloc[0:2,1:5]

#at based
data.at[0,"city"]
#iat based
data.iat[0,2]


# If we want to change the data

# Whenever we will try to change something in data we will do it by making a copy of that data first
# This will prevent the change in original data

cities=data["city"].copy()
cities[0]="Mumbai"
cities


data
