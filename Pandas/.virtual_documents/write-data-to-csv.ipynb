import pandas as pd


raw_data=pd.read_csv("raw_data.csv")
raw_data

sorted_data=raw_data.copy()


# So we will do some basic cleaning of the data and then we will store it in file sorted_raw_data.csv file.

sorted_data = sorted_data.drop_duplicates()              # It will remove all the repeating data
sorted_data = sorted_data.fillna(0)                      # It will fill NaN values with 0
sorted_data = sorted_data.sort_values("income")          # It will sort the values on the basis of income

sorted_data = sorted_data.reset_index(drop=True)         # It will not preserve the index and the index wil reset

sorted_data.to_csv("sorted_raw_data.csv")      # It will store the sorted_data in sorted_raw_data.csv        


sorted_data
