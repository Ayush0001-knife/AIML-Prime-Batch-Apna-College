import pandas as pd


data = pd.read_csv("globalAirQuality.csv")
data


# Filtering of Data

data[data["aqi"]>100]    # It will print the data but with aqi greater then 100 only 
data[(data["aqi"]>100) & (data["temperature"] > 30)]   # It will print the data but with aqi greater then 100 only and temperature greater then 30

data[(data["aqi"]>100) & (data["temperature"] > 30)][["city","aqi","temperature"]]   # It will print the city name and aqi which is  greater then 100

# Pandas does not change the lable from orginal data while filtering
# Pandas Preserve the original labels in filtered Data

aqi_data=data[(data["aqi"]>100) & (data["temperature"] > 30)][["city","aqi","temperature"]]
aqi_data.iloc[0]   # This is index 0 which exists in the filtered data
# aqi_data.loc[0]    # This is label 0 which does not exist in the filtered data so it will give the error 
aqi_data.loc[6]   # This is asking to print label 6 data and it will not give error because label 6 exists in the filtered data
# Here in the above code aqi_data.iloc[0] and aqi_data.loc[6] will be same because in filtered data the first element has index 0 and label 6 contain same data




# Filtering of Data using query 
# Query returns the Filtered Data's Copy not its View

data.query("aqi>100 & temperature >30")[["city","aqi"]]

aqi_val=111
data.query("aqi > @aqi_val & temperature >30")[["city","aqi"]]

