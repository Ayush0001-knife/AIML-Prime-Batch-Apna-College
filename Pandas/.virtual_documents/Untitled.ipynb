import pandas as pd


# Cleaning Data
raw_data=pd.read_csv("raw_data.csv")
raw_data


# 1-> Handle Missing Values

# isnull() / isna() => Returns True if value i not present and returns False when value is present.
raw_data.isnull()
raw_data.isna()


# isnull().sum() => We can count the missing values in every column 
raw_data.isnull().sum()
raw_data.isna().sum()



