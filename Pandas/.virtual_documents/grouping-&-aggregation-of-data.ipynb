import pandas as pd


raw_data=pd.read_csv("raw_data.csv")
raw_data


# groupby() -> Here we have to define the parameter on the basis of which we have to group our data.

# after grouping the data we perform min,max,mean etc functions on that data

raw_data.groupby("country")["income"].mean()
raw_data.groupby("country")["income"].max()
raw_data.groupby("country")["income"].sum()
raw_data.groupby("country")["income"].min()
raw_data.groupby("country")["income"].count()


raw_data.groupby("gender")["income"].count()


# agg()    ->    If we have to perform more then one operation on th grouped data then we use it 
raw_data.groupby("country")["income"].agg(["mean","max","min"])

#aggregate()   ->   It has the same use as of the agg() fxn.
raw_data.groupby("country")["income"].aggregate(["mean","max","min"])

# We can rename the columns also in it 
raw_data.groupby("country")["income"].agg(avg_salary="mean",max_salary="max",min_salary="min")

# We can apply different operations on the different columns of aggregated data
raw_data.groupby("country").agg({
    "income":"mean",
    "age":"mean",
})
