import requests


URL="https://www.scrapethissite.com/pages/simple/"
res=requests.get(URL)


if(res.status_code==200):
    # print(res.text)  
    pass
else:
    print("Failed to fetch")   


with open("scraped_data/data1.html","w") as f:
    f.write(res.text)


# BeautifulSoup

# Install The BeautifulSoup python library -> %pip install beautifulsoup4

# After installing beautiful soup import it 
from bs4 import BeautifulSoup


with open("scraped_data/data1.html","r") as f:
    html_content = f.read()

soup = BeautifulSoup(html_content,"lxml") 


# Methods in BeautifulSoup

# 1-) find()  ->  It is used to find 1st matching element
soup.find("h1")
soup.h3


# 2-) find_all()  ->  It is used to find all the occurences
all_h3=soup.find_all("h3")
for h3 in all_h3:
    print(h3.get_text(strip=True))


# 3-)  find_parent()  ->  It is used to find the parent element of an element
all_h3=soup.find_all("h3")
for h3 in all_h3:
    print(h3.find_parent("div"))


# 4-)  find_next()  ->  It is used to travel documnet in forward
soup.find_next()


# 5-)  find_previous  -> It is used to travel document in previous direction
soup.find_previous() 
